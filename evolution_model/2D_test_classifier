from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.neural_network import MLPClassifier
from sklearn.metrics import accuracy_score, classification_report

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# 1. Load the dataset 
data = pd.read_csv('/home/matthew/Documents/Masters/code/Masters/evolution_model/training_data.csv')
#not first row
data = data.iloc[1:]
Period = data["Period (days)"]
Mass = data["Stellar Mass (M_sun)"]
X = np.column_stack((Period, Mass))

#Y = data['Final Fraction'].to_numpy()
Y = (data["Final Envelope Fraction"] > 1e-3).astype(int)  

# 2. Split into 80% training data and 20% test data
X_train, X_test, y_train, y_test = train_test_split(
    X, Y, test_size=0.2, random_state=42
)

# 3. Scale 
x_scaler = StandardScaler()
X_train_scaled = x_scaler.fit_transform(X_train)
X_test_scaled = x_scaler.transform(X_test)

# 4. Instantiate and train the Multi-Layer Perceptron
mlp = MLPClassifier(
    hidden_layer_sizes=(64, 32), # 2 hidden layers with 64 and 32 neurons
    activation='relu',           # Standard activation function
    max_iter=3000,                # Maximum iterations/epochs
    random_state=42
)
mlp.fit(X_train_scaled, y_train)

# 5. Evaluate the model performance
predictions = mlp.predict(X_test_scaled)
print(f"Overall Accuracy: {accuracy_score(y_test, predictions):.2%}\n")
print(classification_report(y_test, predictions))

acc = accuracy_score(y_test, predictions)

